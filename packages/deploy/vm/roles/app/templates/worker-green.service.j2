[Unit]
Description=Worker (Green)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_dir }}/green/packages/backend
ExecStart=/usr/bin/node dist/workers.js
ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=30
Restart=always
RestartSec=10

# Environment
EnvironmentFile={{ app_dir }}/green/.env
Environment="NODE_ENV=production"
Environment="DEPLOYMENT_COLOR=green"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=worker-green

# Security
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE={{ max_open_files }}
LimitNPROC={{ max_user_processes }}

# Memory limits
MemoryMax=2G
MemoryHigh=1500M

[Install]
WantedBy=multi-user.target
