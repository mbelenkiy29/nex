[Unit]
Description=Backend API (Green)
After=network.target redis-server.service
Wants=redis-server.service

[Service]
Type=simple
User={{ app_user }}
Group={{ app_group }}
WorkingDirectory={{ app_dir }}/green/packages/backend
ExecStart=/usr/bin/node dist/server.js
ExecStop=/bin/kill -SIGTERM $MAINPID
TimeoutStopSec=30
Restart=always
RestartSec=10

# Environment
EnvironmentFile={{ app_dir }}/green/.env
Environment="NODE_ENV=production"
Environment="PORT={{ green_backend_port }}"
Environment="DEPLOYMENT_COLOR=green"

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=backend-green

# Security
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE={{ max_open_files }}
LimitNPROC={{ max_user_processes }}

# Memory limits (adjust as needed)
MemoryMax=2G
MemoryHigh=1500M

[Install]
WantedBy=multi-user.target
