# MinIO root credentials
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}

# MinIO site name (optional)
MINIO_SITE_NAME={{ app_name }}

# MinIO region (optional)
MINIO_SITE_REGION={{ minio_region }}

# Browser access (enabled by default)
MINIO_BROWSER=on

# Server URL (for HTTPS via Caddy reverse proxy)
MINIO_SERVER_URL=https://{{ minio_domain }}
MINIO_BROWSER_REDIRECT_URL=https://{{ minio_console_domain }}
