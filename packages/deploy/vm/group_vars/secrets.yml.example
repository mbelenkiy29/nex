---
# Copy this file to secrets.yml and fill in your actual values
# NEVER commit secrets.yml to version control!
#
# SECURITY: Generate strong random passwords using:
#   openssl rand -base64 32

# GitHub Access Token (for private repositories)
github_token: "ghp_your_github_personal_access_token_here"

# Cloudflare API Token (required only if subdomain_enabled: true)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Zone > DNS > Edit
cloudflare_api_token: "your_cloudflare_api_token_here"

# Database password (REQUIRED: use a strong random password)
postgres_password: "CHANGE_ME_use_openssl_rand_base64_32"

# Redis password (RECOMMENDED for defense in depth, even on localhost)
redis_password: "CHANGE_ME_use_openssl_rand_base64_32"

# MinIO credentials (REQUIRED: change these from defaults!)
# WARNING: Never use default credentials like app_user in production
minio_root_user: "CHANGE_ME_minio_root"
minio_root_password: "CHANGE_ME_use_openssl_rand_base64_32"
minio_app_user: "CHANGE_ME_minio_app"
minio_app_password: "CHANGE_ME_use_openssl_rand_base64_32"

# Application environment variables
app_env_vars:
  # Database
  DATABASE_RLS_URL: "postgresql://{{ postgres_user }}:{{ postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}?schema=public"
  DATABASE_RLS_USER: "CHANGE_ME_rls_user"
  DATABASE_RLS_PASSWORD: "CHANGE_ME_use_openssl_rand_base64_32"
  DATABASE_BYPASS_RLS_URL: "postgresql://{{ postgres_user }}:{{ postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}?schema=public"
  DATABASE_MIGRATION_URL: "postgresql://{{ postgres_user }}:{{ postgres_password }}@{{ postgres_host }}:{{ postgres_port }}/{{ postgres_db }}?schema=public"
  DATABASE_NAME: "{{ postgres_db }}"
  DATABASE_SCHEMA: "public"
  DATABASE_SCHEMA_JOBS: "pgboss"

  # Redis
  REDIS_URL: "redis://:{{ redis_password }}@{{ redis_host }}:{{ redis_port }}"

  # Authentication (REQUIRED: use `openssl rand -base64 32` to generate)
  AUTH_SECRET: "CHANGE_ME_use_openssl_rand_base64_32"
  AUTH_BYPASS_EMAIL_VERIFICATION: "false"

  # OAuth - Google
  AUTH_GOOGLE_ID: "your_google_client_id.apps.googleusercontent.com"
  AUTH_GOOGLE_SECRET: "your_google_client_secret"

  # Email Configuration
  EMAIL_FROM: "noreply@{{ domain_name }}"
  EMAIL_SMTP_HOST: "smtp.gmail.com"
  EMAIL_SMTP_PORT: "587"
  EMAIL_SMTP_USER: "your-email@example.com"
  EMAIL_SMTP_PASSWORD: "your-smtp-password"

  # URLs
  BACKEND_URL: "https://{{ domain_name }}"
  FRONTEND_URL: "https://{{ domain_name }}"

  # Recaptcha (optional)
  RECAPTCHA_SECRET_KEY: ""
  RECAPTCHA_SITE_KEY: ""

  # Organization Mode
  ORGANIZATION_MODE: "multi"
  ORGANIZATION_DEFAULT_ROLE: "member"
  ORGANIZATION_MULTI_DOMAIN_MODE: "subdomain"
  ORGANIZATION_DOMAIN_TRUSTED_ORIGINS: ""

  # Subscription
  SUBSCRIPTION_MODE: "organization"

  # Stripe
  STRIPE_SECRET_KEY: "sk_live_your_stripe_secret_key"
  STRIPE_PUBLISHABLE_KEY: "pk_live_your_stripe_publishable_key"
  STRIPE_WEBHOOK_SECRET: "whsec_your_stripe_webhook_secret"

  # S3 File Storage (AWS S3 or S3-compatible: Minio, Cloudflare R2, Backblaze B2, etc.)
  # Using MinIO for production deployment via HTTPS (Caddy reverse proxy)
  S3_BUCKET: "{{ minio_bucket }}"
  S3_ACCESS_KEY_ID: "{{ minio_app_user }}"
  S3_SECRET_ACCESS_KEY: "{{ minio_app_password }}"
  S3_REGION: "{{ minio_region }}"
  S3_ENDPOINT: "https://{{ minio_domain }}"

  # Anthropic API (for AI Chatbot)
  ANTHROPIC_API_KEY: ""

  # Chatbot Token Limits (tokens per day)
  CHATBOT_DAILY_TOKEN_LIMIT_USER: "50000"
  CHATBOT_DAILY_TOKEN_LIMIT_ORGANIZATION: "1000000"
  CHATBOT_DAILY_TOKEN_LIMIT_GLOBAL: "1000000"

  # Push Notifications
  PUSH_NOTIFICATIONS_ENABLED: "false"
  VAPID_PUBLIC_KEY: ""
  VAPID_PRIVATE_KEY: ""

  EXPO_ACCESS_TOKEN: ""

  # Background job processing mode: 'worker' (pgBoss), 'cron' (external cron), 'inline' (immediate)
  BACKGROUND_JOB_MODE: "worker"

  # Cron Secret for background job processing endpoint (required for cron mode)
  CRON_SECRET: "CHANGE_ME_use_openssl_rand_base64_32"

  # Application settings
  NODE_ENV: "production"
  # Note: PORT is managed by systemd service templates for blue/green deployments
  # Do not set PORT here - it's automatically set to 3011 (blue) or 4011 (green)

  # Frontend build environment variables
  VITE_BACKEND_URL: "https://{{ domain_name }}"
