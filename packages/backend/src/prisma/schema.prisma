// --- One-on-One Calls ------------------------------------------------------
// Course-scoped 1:1 video sessions between an enrolled student and the course
// instructor (a Course creator). Like the rest of the Course* family, these
// tables omit `organizationId` (access is enrollment/instructor-guarded, not
// org-scoped, so RLS is not auto-enabled).

enum OneOnOneSessionStatus {
  pendingPayment
  confirmed
  completed
  cancelledByStudent
  cancelledByInstructor
  noShow
  expired
  disputed
  refunded
}

enum OneOnOneDisputeStatus {
  open
  underReview
  resolvedRefund
  resolvedNoRefund
}

// A recurring weekly availability window for an instructor. Stored as
// minute-of-day in the instructor's IANA timezone so DST math stays explicit.
model InstructorAvailability {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  instructorUserId String   @db.Uuid
  instructorUser   User     @relation(fields: [instructorUserId], references: [id], onDelete: Cascade)
  dayOfWeek        Int // 0 = Sunday .. 6 = Saturday
  startMinute      Int // minutes from local midnight, inclusive
  endMinute        Int // minutes from local midnight, exclusive
  timezone         String // IANA tz the window is expressed in
  isActive         Boolean  @default(true)

  @@index([instructorUserId])
  @@index([instructorUserId, dayOfWeek])
}

// A bookable offering. courseId null = applies to all the instructor's courses.
model OneOnOneSessionType {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)
  instructorUserId String   @db.Uuid
  instructorUser   User     @relation(fields: [instructorUserId], references: [id], onDelete: Cascade)
  courseId         String?  @db.Uuid
  course           Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  durationMinutes  Int
  isFree           Boolean  @default(true)
  priceCents       Int? // required when isFree = false
  currency         String   @default("USD")
  bufferMinutes    Int      @default(0)
  minNoticeHours   Int      @default(12)
  isActive         Boolean  @default(true)

  sessions OneOnOneSession[]

  @@index([instructorUserId])
  @@index([courseId])
}

// A booked 1:1 session instance.
model OneOnOneSession {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @db.Timestamptz(3)
  sessionTypeId    String              @db.Uuid
  sessionType      OneOnOneSessionType @relation(fields: [sessionTypeId], references: [id], onDelete: Restrict)
  courseId         String              @db.Uuid
  course           Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorUserId String              @db.Uuid
  instructorUser   User                @relation("oneOnOneInstructor", fields: [instructorUserId], references: [id], onDelete: Cascade)
  studentUserId    String              @db.Uuid
  studentUser      User                @relation("oneOnOneStudent", fields: [studentUserId], references: [id], onDelete: Cascade)

  // Scheduled times are always stored UTC; clients render in the viewer's tz.
  scheduledStartAt DateTime  @db.Timestamptz(3)
  scheduledEndAt   DateTime  @db.Timestamptz(3)
  // Slot start used by the double-booking unique constraint. Null once the
  // session is cancelled/expired, which frees the slot (NULLs are distinct).
  slotKey          DateTime? @db.Timestamptz(3)

  status OneOnOneSessionStatus @default(confirmed)

  // Meeting link (auto-generated Jitsi room).
  jitsiRoomName String @unique
  jitsiUrl      String

  // Payment (null for free sessions).
  priceCents              Int?
  currency                String         @default("USD")
  stripeCheckoutSessionId String?        @unique
  stripePaymentIntentId   String?
  paidAt                  DateTime?      @db.Timestamptz(3)
  refundedAt              DateTime?      @db.Timestamptz(3)
  refundCents             Int?
  payoutId                String?        @db.Uuid
  payout                  CreatorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  paymentExpiresAt        DateTime?      @db.Timestamptz(3)

  // Cancellation.
  cancelledAt        DateTime? @db.Timestamptz(3)
  cancelledByUserId  String?   @db.Uuid
  cancellationReason String?
  isLateCancel       Boolean   @default(false)

  notes                OneOnOneSessionNote[]
  dispute              OneOnOneDispute?
  trustSafetyRiskFlags TrustSafetyRiskFlag[]

  @@unique([instructorUserId, slotKey])
  @@index([studentUserId])
  @@index([instructorUserId, status])
  @@index([courseId])
  @@index([scheduledStartAt])
  @@index([status, paymentExpiresAt])
}

// A note attached to a session. isShared = visible to both parties.
model OneOnOneSessionNote {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @db.Timestamptz(3)
  sessionId    String          @db.Uuid
  session      OneOnOneSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  authorUserId String          @db.Uuid
  authorUser   User            @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  body         String
  isShared     Boolean         @default(false)

  @@index([sessionId])
}

// A student-opened dispute over a paid session, resolved by a platform admin.
model OneOnOneDispute {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)
  sessionId        String                @unique @db.Uuid
  session          OneOnOneSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  openedByUserId   String                @db.Uuid
  openedByUser     User                  @relation(fields: [openedByUserId], references: [id], onDelete: Cascade)
  reason           String
  status           OneOnOneDisputeStatus @default(open)
  resolutionNotes  String?
  resolvedByUserId String?               @db.Uuid
  resolvedAt       DateTime?             @db.Timestamptz(3)

  @@index([status])
}

// GDPR data-export request. Worker collects the user's data into a private
// S3 zip; the row holds the result + a signed download is minted on demand.
model UserDataExport {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  completedAt    DateTime?    @db.Timestamptz(3)
  failedAt       DateTime?    @db.Timestamptz(3)
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  s3Key          String?
  errorMessage   String?

  @@index([userId, createdAt])
}

// One-shot tokens issued by the email worker so a click on the unsubscribe
// footer can flip a user's emailUnsubscribedChannels without requiring sign-in.
model EmailUnsubscribeToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  consumedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  // Backs the daily cleanup cron's `deleteMany({ where: { consumedAt:
  // { not: null, lt: thirtyDaysAgo } } })` query (security audit #19).
  @@index([consumedAt])
}

// One-shot 24h-TTL token emailed after a deletion request. Confirming the
// link transitions deletion from "requested" to "locked in" (deletionConfirmedAt).
model AccountDeletionConfirmationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  consumedAt DateTime? @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  // Backs the half of the cleanup cron filtering on `consumedAt < threshold`
  // (security audit #19). The expiresAt index covers the other half.
  @@index([consumedAt])
}
