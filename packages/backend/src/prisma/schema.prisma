// Audit trail of every Stripe Price ever attached to a course. Rotation flow
// (price/currency change on an approved paid course) flips `isActive=false`
// and `archivedAt=now()` on the old row, inserts a new active row, and
// reassigns `Course.stripePriceId`. Serialized by
// pg_advisory_xact_lock(hashtext(courseId)) inside coursePaymentService.
model CourseStripePrice {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  courseId        String    @db.Uuid
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  stripeProductId String
  stripePriceId   String    @unique
  priceCents      Int
  currency        String
  isActive        Boolean   @default(true)
  archivedAt      DateTime? @db.Timestamptz(3)

  @@index([courseId, isActive])
}

