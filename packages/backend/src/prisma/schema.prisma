  audience                    String?
  courseTopics                String[]  @default([])
  sampleLessonPlan            String?
  links                       String[]  @default([])
  payoutContact               String?
  payoutOnboardingStatus      String    @default("notStarted")
  payoutOnboardingNotes       String?
