// One row per successful Stripe Checkout (`mode:'payment'`) for a course.
// Idempotency key: `stripeCheckoutSessionId` is unique. On refund, admin marks
// the row (sets refundedAt + refundReason + refundedByUserId); the matching
// CourseEnrollment flips to status='refunded' and the linked CreatorPayout is
// cancelled. Re-purchases insert a new row and the webhook upsert flips the
// enrollment back to 'active'.
model CoursePurchase {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  courseId       String        @db.Uuid
  course         Course        @relation(fields: [courseId], references: [id], onDelete: Restrict)
  userId         String        @db.Uuid
  user           User          @relation("coursePurchaseUser", fields: [userId], references: [id], onDelete: Restrict)
  memberId       String?       @db.Uuid
  member         Member?       @relation("coursePurchaseMember", fields: [memberId], references: [id], onDelete: SetNull)
  organizationId String?       @db.Uuid
  organization   Organization? @relation("coursePurchaseOrganization", fields: [organizationId], references: [id], onDelete: SetNull)

  stripeCheckoutSessionId String   @unique
  stripePaymentIntentId   String?
  priceCents              Int
  currency                String   @default("USD")
  paidAt                  DateTime @default(now()) @db.Timestamptz(3)
  packageType             String?
  pricingPackageId        String?
  pricingExperimentId     String?
  pricingVariantId        String?
  accessDuration          String   @default("standard")

  refundedAt       DateTime? @db.Timestamptz(3)
  refundedByUserId String?   @db.Uuid
  refundedByUser   User?     @relation("coursePurchaseRefundedBy", fields: [refundedByUserId], references: [id], onDelete: SetNull)
  refundReason     String?

  payoutId String?        @db.Uuid
  payout   CreatorPayout? @relation("coursePurchasePayout", fields: [payoutId], references: [id], onDelete: SetNull)

  couponRedemptions CourseCouponRedemption[]

  @@index([userId])
  @@index([courseId])
  @@index([refundedAt])
}

