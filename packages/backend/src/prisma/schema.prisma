// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  // Better Auth fields
  email         String  @unique
  emailVerified Boolean @default(false)
  name          String  @default("")
  image         String?

  // Freeform note a creator gives admins about how to wire their payout —
  // bank ACH details, Wise email, PayPal, etc. Plain text; not machine-
  // processed. Surfaced on the admin payout queue so admins know where to
  // send funds (manual mark-paid flow, not Stripe Connect).
  payoutMethodNote String?

  // Compliance / legal columns. All nullable + defaulted so backfill is not
  // required; pre-existing accounts are grandfathered (no consent on file).
  // The signup flow stamps termsAcceptedAt/privacyAcceptedAt + dateOfBirth
  // for every new account; COPPA gate blocks under-13 in v1.
  dateOfBirth            DateTime? @db.Date
  termsAcceptedAt        DateTime? @db.Timestamptz(3)
  termsAcceptedVersion   String?
  privacyAcceptedAt      DateTime? @db.Timestamptz(3)
  privacyAcceptedVersion String?

  // Account-deletion state machine. Request → confirm (via email token) →
  // a daily cron picks confirmed rows whose scheduledFor has elapsed and
  // anonymizes the row. CoursePurchase / AuditLog / OneOnOneSession are
  // kept around (tax-retention) joined to an anonymized User row.
  deletionRequestedAt  DateTime? @db.Timestamptz(3)
  deletionScheduledFor DateTime? @db.Timestamptz(3) // requestedAt + 14 days
  deletionConfirmedAt  DateTime? @db.Timestamptz(3)
  deletedAt            DateTime? @db.Timestamptz(3) // PII-anonymized at this time

  // Channels the user has opted out of. 'auth' and 'transactional' are
  // never honored (legal/security notices always send). Allowed values
  // currently: 'marketing' | 'digest' | 'productUpdates'.
  emailUnsubscribedChannels String[] @default([])

  // { essential: true, analytics: bool, marketing: bool, acceptedAt: ISO }
  cookieConsent Json?

  members           Member[]
  subscriptions     Subscription[]
  sessions          Session[]
  accounts          Account[]
  apiKeys           ApiKey[]
  pushTokens        PushToken[]
  notifications     Notification[]
  invitations       Invitation[]
  oauthApplications OauthApplication[]
  oauthAccessTokens OauthAccessToken[]
  oauthConsents     OauthConsent[]

  platformPromotionsCreated         PlatformPromotion[]           @relation("platformPromotionCreatedBy")
  platformPromotionsUpdated         PlatformPromotion[]           @relation("platformPromotionUpdatedBy")
  creatorPayoutsCreator             CreatorPayout[]               @relation("creatorPayoutCreator")
  creatorPayoutsCreated             CreatorPayout[]               @relation("creatorPayoutCreatedBy")
  creatorPayoutsUpdated             CreatorPayout[]               @relation("creatorPayoutUpdatedBy")
  coursesCreated                    Course[]                      @relation("courseCreatedBy")
  coursesUpdated                    Course[]                      @relation("courseUpdatedBy")
  coursesCreator                    Course[]                      @relation("courseCreator")
  coursePracticeAttempts            CoursePracticeAttempt[]
  courseStudentNotes                CourseStudentNote[]
  courseStudyPlanItems              CourseStudyPlanItem[]
  courseDiagnosticAttempts          CourseDiagnosticAttempt[]
  courseDomainMastery               CourseDomainMastery[]
  courseReadinessSnapshots           CourseReadinessSnapshot[]
  courseFlashcardReviews            CourseFlashcardReview[]
  courseStudyStreaks                CourseStudyStreak[]
  courseRemediationPlans            CourseRemediationPlan[]
  courseLearningSessions            CourseLearningSession[]
  studentOnboardingProfiles         StudentOnboardingProfile[]
  aiTrustPreference                 AiTrustPreference?
  studentReminderPreferences        StudentReminderPreference[]
  studentReminderDeliveries         StudentReminderDelivery[]
  coursesReviewed                   Course[]                      @relation("courseReviewedBy")
  courseReviewDecisions             CourseReviewDecision[]        @relation("courseReviewDecisionReviewer")
  courseSafetyHolds                 Course[]                      @relation("courseSafetyHoldBy")
  courseRatings                     CourseRating[]
  courseWishlists                   CourseWishlist[]
  courseWishlistItems               CourseWishlistItem[]
  courseCouponRedemptions           CourseCouponRedemption[]
  courseCouponsCreated              CourseCoupon[]
  courseBundlesCreated              CourseBundle[]                @relation("courseBundleCreator")
  courseBundlePurchases             CourseBundlePurchase[]         @relation("courseBundlePurchaseUser")
  courseCertificates                CourseCertificate[]
  pricingExperimentsCreated         PricingExperiment[]            @relation("pricingExperimentCreatedBy")
  pricingExposures                  PricingExposure[]              @relation("pricingExposureUser")
  aiCreditPurchases                 AiCreditPurchase[]             @relation("aiCreditPurchaseUser")
  aiCreditLedgerEntries             AiCreditLedgerEntry[]          @relation("aiCreditLedgerUser")
  trustSafetyReportsFiled           TrustSafetyReport[]           @relation("trustSafetyReportReporter")
  trustSafetyReportsTeacher         TrustSafetyReport[]           @relation("trustSafetyReportTeacher")
  trustSafetyReportsResolved        TrustSafetyReport[]           @relation("trustSafetyReportResolvedBy")
  trustSafetyReportsAssigned        TrustSafetyReport[]           @relation("trustSafetyReportAssignedTo")
  trustSafetyPolicyVersionsCreated  TrustSafetyPolicyVersion[]    @relation("trustSafetyPolicyVersionCreatedBy")
  trustSafetyPolicyAcceptances      TrustSafetyPolicyAcceptance[]
  trustSafetyRiskFlagsCreator       TrustSafetyRiskFlag[]         @relation("trustSafetyRiskFlagCreator")
  trustSafetyRiskFlagsCreated       TrustSafetyRiskFlag[]         @relation("trustSafetyRiskFlagCreatedBy")
  trustSafetyRiskFlagsResolved      TrustSafetyRiskFlag[]         @relation("trustSafetyRiskFlagResolvedBy")
  creatorApplicationsSafetyDisabled CreatorApplication[]          @relation("creatorSafetyDisabledBy")

  instructorAvailability       InstructorAvailability[]
  oneOnOneSessionTypes         OneOnOneSessionType[]
  oneOnOneSessionsAsInstructor OneOnOneSession[]        @relation("oneOnOneInstructor")
  oneOnOneSessionsAsStudent    OneOnOneSession[]        @relation("oneOnOneStudent")
  oneOnOneSessionNotes         OneOnOneSessionNote[]
  oneOnOneDisputesOpened       OneOnOneDispute[]

  coursePurchases           CoursePurchase[] @relation("coursePurchaseUser")
  coursePurchasesRefundedBy CoursePurchase[] @relation("coursePurchaseRefundedBy")

  chatbotConversations ChatbotConversation[]

  // Compliance feature relations (see UserDataExport, EmailUnsubscribeToken,
  // AccountDeletionConfirmationToken at the bottom of this file).
  dataExports                  UserDataExport[]
  emailUnsubscribeTokens       EmailUnsubscribeToken[]
  accountDeletionConfirmTokens AccountDeletionConfirmationToken[]

  @@index([deletionScheduledFor])
}

model AiTrustPreference {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)
  userId             String   @unique @db.Uuid
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  useLessonContent   Boolean  @default(true)
  useLessonProgress  Boolean  @default(true)
  usePracticeResults Boolean  @default(true)
  useChatHistory     Boolean  @default(true)
  useAttachments     Boolean  @default(true)

  @@index([userId])
}

model AuditLog {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  timestamp           DateTime @default(now()) @db.Timestamptz(3)
  entityName          String
  entityId            String   @db.Uuid // No FK to keep deleted entities logs
  organizationId      String?  @db.Uuid // No FK to keep deleted entities logs
  userId              String?  @db.Uuid // No FK to keep deleted entities logs
  memberId            String?  @db.Uuid // No FK to keep deleted entities logs
  apiKeyId            String?  @db.Uuid // No FK to keep deleted entities logs
  apiEndpoint         String?
  apiHttpResponseCode String?
  operation           String
  oldData             Json?
  newData             Json?
}

model ProductAnalyticsEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  eventName String
  source    String
  dedupeKey String? @unique

  userId                  String? @db.Uuid
  memberId                String? @db.Uuid
  organizationId          String? @db.Uuid
  courseId                String? @db.Uuid
  lessonId                String? @db.Uuid
  subscriptionId          String? @db.Uuid
  coursePurchaseId        String? @db.Uuid
  stripeCheckoutSessionId String?
  stripePriceId           String?
  accessType              String?
  ctaLocation             String?
  funnelId                String?
  sessionId               String?
  anonymousId             String?
  currentPath             String?
  referrerPath            String?
  metadata                Json    @default("{}")

  @@index([eventName, createdAt])
  @@index([courseId, eventName, createdAt])
  @@index([userId, createdAt])
  @@index([funnelId, eventName])
  @@index([stripeCheckoutSessionId])
}

model PricingExperiment {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  key             String    @unique
  name            String
  status          String    @default("draft")
  surface         String    @default("global")
  trafficPercent  Int       @default(100)
  startsAt        DateTime? @db.Timestamptz(3)
  endsAt          DateTime? @db.Timestamptz(3)
  metadata        Json      @default("{}")
  createdByUserId String?   @db.Uuid
  createdByUser   User?     @relation("pricingExperimentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  variants  PricingVariant[]
  exposures PricingExposure[]

  @@index([status, surface])
  @@index([createdByUserId])
}

model PricingVariant {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  experimentId String            @db.Uuid
  experiment   PricingExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  key          String
  name         String
  allocationBps Int              @default(10000)
  isControl    Boolean           @default(false)
  orderIndex   Int               @default(0)
  packageConfig Json             @default("{}")

  exposures PricingExposure[]

  @@unique([experimentId, key])
  @@index([experimentId, orderIndex])
}

model PricingExposure {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(3)
  userId         String?           @db.Uuid
  user           User?             @relation("pricingExposureUser", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?           @db.Uuid
  memberId       String?           @db.Uuid
  experimentId   String            @db.Uuid
  experiment     PricingExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variantId      String            @db.Uuid
  variant        PricingVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  surface        String
  sessionId      String?
  anonymousId    String?
  currentPath    String?
  metadata       Json              @default("{}")

  @@unique([experimentId, userId])
  @@index([userId, createdAt])
  @@index([surface, createdAt])
  @@index([variantId, createdAt])
}

model AiCreditPack {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(3)
  key             String    @unique
  name            String
  description     String?
  status          String    @default("active")
  tokenAmount     Int
  bonusTokenAmount Int      @default(0)
  priceCents      Int
  currency        String    @default("USD")
  stripeProductId String?
  stripePriceId   String?
  displayOrder    Int       @default(1000)

  purchases     AiCreditPurchase[]
  ledgerEntries AiCreditLedgerEntry[]

  @@index([status, displayOrder])
}

model AiCreditPurchase {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  aiCreditPackId String       @db.Uuid
  aiCreditPack   AiCreditPack @relation(fields: [aiCreditPackId], references: [id], onDelete: Restrict)
  userId         String       @db.Uuid
  user           User         @relation("aiCreditPurchaseUser", fields: [userId], references: [id], onDelete: Restrict)
  memberId       String?      @db.Uuid
  organizationId String?      @db.Uuid

  stripeCheckoutSessionId String   @unique
  stripePaymentIntentId   String?
  tokensPurchased         Int
  priceCents              Int
  currency                String   @default("USD")
  paidAt                  DateTime @default(now()) @db.Timestamptz(3)
  pricingPackageId        String?
  pricingExperimentId     String?
  pricingVariantId        String?

  ledgerEntries AiCreditLedgerEntry[]

  @@index([userId, createdAt])
  @@index([aiCreditPackId])
}

model AiCreditLedgerEntry {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  userId         String  @db.Uuid
  user           User    @relation("aiCreditLedgerUser", fields: [userId], references: [id], onDelete: Cascade)
  organizationId String? @db.Uuid
  entryType      String
  tokenAmount    Int
  source         String?
  aiCreditPackId String? @db.Uuid
  aiCreditPack   AiCreditPack? @relation(fields: [aiCreditPackId], references: [id], onDelete: SetNull)
  purchaseId     String? @db.Uuid
  purchase       AiCreditPurchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  metadata       Json    @default("{}")

  @@index([userId, createdAt])
  @@index([purchaseId])
}

// Better Auth API Key model
model ApiKey {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  configId    String  @default("default")
  name        String?
  start       String? // Starting characters for display
  prefix      String? // API key prefix
  key         String  @unique // Hashed API key
  referenceId String  @db.Uuid
  user        User    @relation(fields: [referenceId], references: [id], onDelete: Cascade)

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  refillInterval Int?
  refillAmount   Int?
  lastRefillAt   DateTime? @db.Timestamptz(3)

  enabled Boolean? @default(true)

  rateLimitEnabled    Boolean? @default(true)
  rateLimitTimeWindow Int?     @default(86400000)
  rateLimitMax        Int?     @default(1000)
  requestCount        Int?     @default(0)

  remaining   Int?
  lastRequest DateTime? @db.Timestamptz(3)
  expiresAt   DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  permissions String? // JSON string of permissions
  metadata    Json? // Additional metadata

  @@index([organizationId])
}

model PushToken {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String // 'web' or 'mobile' (expo, fcm, apns)
  token          String // For mobile: Expo push token. For web: subscription endpoint
  platform       String? // For mobile: 'ios' or 'android'. Null for web
  p256dh         String? // For web push: encryption key
  auth           String? // For web push: authentication secret
  expirationTime DateTime? @db.Timestamptz(3) // For web push: subscription expiration
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@unique([userId, token])
  @@index([userId])
  @@index([type])
}

model Notification {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String    @db.Uuid
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String    @db.Uuid
  type           String // 'memberAdded', 'memberRemoved', etc.
  roles          String[] // Roles that should receive this notification (e.g., ['admin'])
  payload        Json // Notification-specific data (member details, etc.)
  readAt         DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([organizationId])
  @@index([userId, readAt])
}

model Organization {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                 String
  slug                 String   @unique
  logosDark            Json?
  logosLight           Json?
  backgroundImageDark  Json?
  backgroundImageLight Json?
  metadata             Json?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)
  logo                 String?
  createdByUserId      String?  @db.Uuid
  updatedByUserId      String?  @db.Uuid

  members                      Member[]
  invitations                  Invitation[]
  subscriptions                Subscription[]
  apiKeys                      ApiKey[]
  examOrganization             Exam[]
  chapterOrganization          Chapter[]
  lessonOrganization           Lesson[]
  practiceQuestionOrganization PracticeQuestion[]
  conceptOrganization          Concept[]
  examTypeOrganization         ExamType[]
  examInstanceOrganization     ExamInstance[]
  dailyGoalOrganization        DailyGoal[]
  studyNoteOrganization        StudyNote[]
  documentUploadOrganization   DocumentUpload[]
  platformPromotions           PlatformPromotion[]
  creatorPayouts               CreatorPayout[]
  coursesCreator               Course[]            @relation("courseCreatorOrganization")
  coursePurchases              CoursePurchase[]    @relation("coursePurchaseOrganization")
  studentOnboardingProfiles    StudentOnboardingProfile[]

  chatbotConversations ChatbotConversation[]
  chatbotMessages      ChatbotMessage[]

  dataExports UserDataExport[]
}

model Member {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  firstName              String?
  lastName               String?
  fullName               String?
  avatars                Json?
  disabled               Boolean   @default(false)
  isNotificationsEnabled Boolean   @default(true)
  // Set once the student finishes the post-signup "pick your first courses"
  // step (Skip also sets it). Null = the auth guard redirects them to
  // /welcome/courses on next sign-in. Backfilled to now() for everyone with a
  // firstName at migration time to grandfather existing users.
  onboardingCompletedAt  DateTime? @db.Timestamptz(3)
  importHash             String?   @unique
  createdByUserId        String?   @db.Uuid
  createdByMemberId      String?   @db.Uuid
  updatedByUserId        String?   @db.Uuid
  updatedByMemberId      String?   @db.Uuid

  createdByMember Member?  @relation("createdByMember", fields: [createdByMemberId], references: [id], onDelete: SetNull)
  memberCreatedBy Member[] @relation("createdByMember")
  updatedByMember Member?  @relation("updatedByMember", fields: [updatedByMemberId], references: [id], onDelete: SetNull)
  memberUpdatedBy Member[] @relation("updatedByMember")

  subscriptions              Subscription[]
  coursesCreator             Course[]                @relation("courseCreatorMember")
  examCreatedBy              Exam[]                  @relation("createdByMember")
  examUpdatedBy              Exam[]                  @relation("updatedByMember")
  examArchivedBy             Exam[]                  @relation("archivedByMember")
  chapterCreatedBy           Chapter[]               @relation("createdByMember")
  chapterUpdatedBy           Chapter[]               @relation("updatedByMember")
  chapterArchivedBy          Chapter[]               @relation("archivedByMember")
  lessonCreatedBy            Lesson[]                @relation("createdByMember")
  lessonUpdatedBy            Lesson[]                @relation("updatedByMember")
  lessonArchivedBy           Lesson[]                @relation("archivedByMember")
  practiceQuestionCreatedBy  PracticeQuestion[]      @relation("createdByMember")
  practiceQuestionUpdatedBy  PracticeQuestion[]      @relation("updatedByMember")
  practiceQuestionArchivedBy PracticeQuestion[]      @relation("archivedByMember")
  conceptCreatedBy           Concept[]               @relation("createdByMember")
  conceptUpdatedBy           Concept[]               @relation("updatedByMember")
  conceptArchivedBy          Concept[]               @relation("archivedByMember")
  examTypeCreatedBy          ExamType[]              @relation("createdByMember")
  examTypeUpdatedBy          ExamType[]              @relation("updatedByMember")
  examTypeArchivedBy         ExamType[]              @relation("archivedByMember")
  examInstanceCreatedBy      ExamInstance[]          @relation("createdByMember")
  examInstanceUpdatedBy      ExamInstance[]          @relation("updatedByMember")
  examInstanceArchivedBy     ExamInstance[]          @relation("archivedByMember")
  examInstanceStudent        ExamInstance[]          @relation("examInstanceStudent_student")
  dailyGoalCreatedBy         DailyGoal[]             @relation("createdByMember")
  dailyGoalUpdatedBy         DailyGoal[]             @relation("updatedByMember")
  dailyGoalArchivedBy        DailyGoal[]             @relation("archivedByMember")
  dailyGoalOwner             DailyGoal[]             @relation("dailyGoalOwner_owner")
  studyNoteCreatedBy         StudyNote[]             @relation("createdByMember")
  studyNoteUpdatedBy         StudyNote[]             @relation("updatedByMember")
  studyNoteArchivedBy        StudyNote[]             @relation("archivedByMember")
  studyNoteAuthor            StudyNote[]             @relation("studyNoteAuthor_author")
  documentUploadCreatedBy    DocumentUpload[]        @relation("createdByMember")
  documentUploadUpdatedBy    DocumentUpload[]        @relation("updatedByMember")
  documentUploadArchivedBy   DocumentUpload[]        @relation("archivedByMember")
  coursePracticeAttempts     CoursePracticeAttempt[]
  courseStudentNotes         CourseStudentNote[]
  courseStudyPlanItems       CourseStudyPlanItem[]
  documentUploadUploadedBy   DocumentUpload[]        @relation("documentUploadUploadedBy_uploadedBy")
  creatorPayoutsCreator      CreatorPayout[]         @relation("creatorPayoutCreatorMember")
  coursePurchases            CoursePurchase[]        @relation("coursePurchaseMember")
  studentOnboardingProfiles  StudentOnboardingProfile[]

  @@unique([id, organizationId])
  @@unique([userId, organizationId])
  @@index([onboardingCompletedAt])
}

model StudentOnboardingProfile {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime     @updatedAt @db.Timestamptz(3)
  organizationId       String       @db.Uuid
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId               String       @db.Uuid
  user                 User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  memberId             String?      @db.Uuid
  member               Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  examGoal             String
  timeline             String
  currentLevel         String
  studyMinutesPerWeek  Int
  targetScore          String
  generatedPlan        Json?
  recommendedCourseIds String[]     @default([])
  completedAt          DateTime?    @db.Timestamptz(3)
  createdByUserId      String?      @db.Uuid
  createdByMemberId    String?      @db.Uuid
  updatedByUserId      String?      @db.Uuid
  updatedByMemberId    String?      @db.Uuid

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([memberId])
  @@index([completedAt])
}

model PlatformPromotion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  kind     String
  title    String
  message  String
  ctaLabel String?
  ctaHref  String?
  audience String    @default("students")
  isActive Boolean   @default(true)
  startsAt DateTime? @db.Timestamptz(3)
  endsAt   DateTime? @db.Timestamptz(3)

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdByUserId String? @db.Uuid
  createdByUser   User?   @relation("platformPromotionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId String? @db.Uuid
  updatedByUser   User?   @relation("platformPromotionUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
}

model CreatorPayout {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  amount      Decimal   @db.Decimal(12, 2)
  currency    String    @default("USD")
  status      String    @default("pending")
  description String?
  paidAt      DateTime? @db.Timestamptz(3)
  cancelledAt DateTime? @db.Timestamptz(3)

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  creatorUserId   String? @db.Uuid
