// NOTE: the CourseQuiz / CourseQuestion / CoursePracticeExam family deliberately has no
// organizationId column. Postgres RLS is auto-enabled only on tables that carry
// organizationId (see setupRowLevelSecurity.ts). Course content is application-guarded
// via Course ownership + enrollment, consistent with the other Course* tables.
model CourseQuiz {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt          DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @db.Timestamptz(3)
  title              String
  description        String?
  orderIndex         Int           @default(0)
  passingScore       Int?
  timeLimitMinutes   Int?
  randomizeQuestions Boolean       @default(false)
  randomizeAnswers   Boolean       @default(false)
  showExplanations   Boolean       @default(true)
  allowRetries       Boolean       @default(true)
  maxAttempts        Int?
  courseId           String        @db.Uuid
  course             Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId           String?       @db.Uuid
  module             CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lessonId           String?       @db.Uuid
  lesson             CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  questions CourseQuizQuestion[]
  attempts  CourseQuizAttempt[]

  @@index([courseId])
  @@index([courseId, orderIndex])
  @@index([moduleId])
  @@index([lessonId])
}

