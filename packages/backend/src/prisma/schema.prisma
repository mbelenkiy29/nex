// Persistent per-user chat thread powering AI Tutor surfaces. Course/lesson
// scoping is optional and drops to NULL if the course or lesson is later
// deleted, preserving the student's chat history. `archivedAt` is a soft-delete
// marker — rows survive for audit and recovery; admins use the
// run_sql_transaction path to hard-purge.
model ChatbotConversation {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(3)
  userId         String        @db.Uuid
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String        @db.Uuid
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  courseId       String?       @db.Uuid
  course         Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)
  lessonId       String?       @db.Uuid
  lesson         CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  title          String
  archivedAt     DateTime?     @db.Timestamptz(3)

  messages ChatbotMessage[]

  @@index([userId, archivedAt, updatedAt])
  @@index([organizationId])
  @@index([courseId])
}

// One row per turn in a ChatbotConversation. Assistant rows may carry a
// `widgets` JSON payload — an array of { kind, payload } objects that the
// frontend renders inline (quiz carousel, study plan list, lesson explain
// card, etc.). Token counts on the assistant row mirror what was charged
// in ChatbotUsage and let us surface per-conversation cost in admin tools.
model ChatbotMessage {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)
  conversationId String              @db.Uuid
  conversation   ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  // Denormalized from `conversation.organizationId`. RLS doesn't cascade
  // through FKs, so a direct `chatbotMessage.findMany(...)` without this
  // column would bypass tenant isolation (security audit finding #5).
  // Stays consistent because Conversation's org never changes; cascade-
  // delete on the parent FK handles user/conversation removal.
  organizationId String              @db.Uuid
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String // 'user' | 'assistant'
  content        String
  attachments    Json?
  widgets        Json?
  trustSignals   Json?
  inputTokens    Int?
  outputTokens   Int?

  @@index([conversationId, createdAt])
  @@index([organizationId])
}

