{
  "name": "@project/backend",
  "version": "1.0.0",
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "start": "dotenv -e .env -- node dist/server.js",
    "start:test": "pnpm build && dotenv -e .env.test -- node dist/server.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "translation:audit": "tsx src/translation/dictionaryFallbackAuditCli.ts",
    "launch:policy:audit": "tsx src/translation/policyLaunchAuditCli.ts",
    "worker": "dotenv -e .env -- tsx src/workers.ts",
    "worker:dev": "dotenv -e .env -- tsx watch src/workers.ts",
    "db:migrate:create": "dotenv -e .env -- prisma generate && dotenv -e .env -c -- prisma migrate dev && dotenv -e .env -c -- tsx src/prisma/setupRowLevelSecurityCli.ts",
    "db:migrate": "dotenv -e .env -- prisma migrate deploy && dotenv -e .env -c -- tsx src/prisma/setupRowLevelSecurityCli.ts",
    "db:backfill:courses": "dotenv -e .env -- tsx src/prisma/backfillCoursesFromExams.ts",
    "vercel-build": "prisma generate && prisma migrate deploy && tsx src/prisma/setupRowLevelSecurityCli.ts && tsup",
    "prisma:generate": "dotenv -e .env -- prisma generate",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate",
    "test": "dotenv -e .env.test -- vitest run",
    "test:watch": "dotenv -e .env.test -- vitest watch",
    "test:ui": "dotenv -e .env.test -- vitest --ui",
    "test:coverage": "dotenv -e .env.test -- vitest run --coverage",
    "test:e2e": "playwright install --with-deps && playwright test",
    "test:e2e:ui": "playwright install --with-deps && playwright test --ui",
    "test:e2e:headed": "playwright install --with-deps && playwright test --headed"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.78.0",
    "@aws-sdk/client-s3": "3.1009.0",
    "@aws-sdk/s3-presigned-post": "3.1009.0",
    "@aws-sdk/s3-request-presigner": "3.1009.0",
    "@hono/node-server": "1.19.11",
    "@prisma/adapter-pg": "7.5.0",
    "@prisma/client": "7.5.0",
    "@vercel/functions": "3.4.3",
    "bcryptjs": "3.0.3",
    "dayjs": "1.11.20",
    "file-saver": "2.0.5",
    "file-type": "21.3.2",
    "filesize": "11.0.13",
    "fs-extra": "11.3.4",
    "hono": "4.12.8",
    "ioredis": "5.10.0",
    "jsonwebtoken": "9.0.3",
    "lodash-es": "4.17.23",
    "mammoth": "1.12.0",
    "mime": "4.1.0",
    "nodemailer": "8.0.2",
    "papaparse": "5.5.3",
    "pdf-parse": "2.4.5",
    "pg": "8.20.0",
    "pg-boss": "12.14.0",
    "pg-connection-string": "2.12.0",
    "qs": "6.15.0",
    "sanitize-filename": "1.6.3",
    "stripe": "20.4.1",
    "uniqid": "5.4.0",
    "uuid": "13.0.0",
    "web-push": "3.6.7",
    "zod": "4.3.6",
    "zod-openapi": "5.4.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@total-typescript/ts-reset": "0.6.1",
    "@types/fs-extra": "11.0.4",
    "@types/jsonwebtoken": "9.0.10",
    "@types/lodash-es": "4.17.12",
    "@types/ms": "2.1.0",
    "@types/node": "25.5.0",
    "@types/nodemailer": "7.0.11",
    "@types/papaparse": "5.5.2",
    "@types/pdf-parse": "1.1.5",
    "@types/pg": "8.18.0",
    "@types/qs": "6.15.0",
    "@types/uniqid": "5.3.4",
    "@types/web-push": "3.6.4",
    "@vitest/ui": "4.1.0",
    "dotenv": "17.3.1",
    "dotenv-cli": "11.0.0",
    "prettier": "3.8.1",
    "prisma": "7.5.0",
    "tsconfig-paths": "4.2.0",
    "tsup": "8.5.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.0.0",
    "vitest": "4.1.0"
  }
}
